{
  "name": "aozora-text-processor",
  "version": "0.1.0",
  "description": "青空文庫テキストを整形するためのユーティリティ集（ルビ除去、注記除去、外字変換、文章分割、チャンク分割）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "build:gaiji-table": "tsx scripts/build-gaiji-table.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "aozora",
    "aozora-bunko",
    "japanese",
    "text-processing",
    "ruby",
    "gaiji",
    "jis-x-0213"
  ],
  "author": "NOT SO BAD",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "sentence-splitter": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  }
}
